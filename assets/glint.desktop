[Desktop Entry]
Type=Application
Name=Glint
GenericName=Text Editor
Comment=A small, pretty text editor with animated backgrounds
Exec=glint %F
Icon=glint
Terminal=false
Categories=Utility;TextEditor;Development;
MimeType=text/plain;text/markdown;application/json;application/x-yaml;application/toml;text/x-cmake;application/x-docbook+xml;text/x-chdr;text/x-csrc;text/x-c++hdr;text/x-c++src;text/x-c;text/x-c++;text/x-java;text/x-dsrc;text/x-pascal;text/x-perl;text/x-python;application/x-php;text/css;text/x-sql;text/x-diff;text/x-patch;text/x-makefile;text/x-tcl;text/x-tex;application/x-shellscript;text/rust;text/x-rust;application/javascript;text/javascript;application/typescript;text/x-go;text/x-lua;text/x-log;text/english;text/x-moc;application/x-zerosize;
StartupWMClass=glint
StartupNotify=true
Keywords=text;editor;notes;code;
